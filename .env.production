# Production.
#
# VITE_API_BASE_URL is deliberately EMPTY, which means same-origin: the API is
# reached at whatever host the page was loaded from. Apache serves the built
# frontend and proxies /api/ to gunicorn from the same virtual host, so this
# is always true in a deployed build -- and it means ONE build serves
# http://intranet.apisuniverse.com/ and http://103.205.66.45/ alike, with no
# hostname baked in and nothing to rebuild when another address is added.
#
# VITE_APP_MODE is also deliberately unset: `hub` swaps the intranet
# dashboard for a two-button landing offering Appraisal and EOM only.
VITE_API_BASE_URL=
